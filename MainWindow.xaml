<Window x:Class="TimeBasedRacingGame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🏁 NEON RACEWAY - Ultimate Speed Challenge" Height="700" Width="900"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="#0a0a0a">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <Border Grid.Row="0" Padding="20" Margin="0,0,0,30">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF00FF" Offset="0"/>
                    <GradientStop Color="#00FFFF" Offset="0.5"/>
                    <GradientStop Color="#FFFF00" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel>
                <TextBlock Text="🏎️ NEON RACEWAY 🏎️" FontSize="32" FontWeight="Black" 
                           HorizontalAlignment="Center" Foreground="Black" 
                           FontFamily="Impact" TextAlignment="Center"/>
                <TextBlock Text="ULTIMATE SPEED CHALLENGE" FontSize="14" FontWeight="Bold" 
                           HorizontalAlignment="Center" Foreground="Black" 
                           FontFamily="Arial Black" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Car Selection -->
        <Border Grid.Row="1" Background="#16213e" BorderBrush="#00FFFF" BorderThickness="2" Padding="25" Margin="0,0,0,30">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="🏎️ CHOOSE YOUR MACHINE:" VerticalAlignment="Center" Margin="0,0,20,0" 
                           Foreground="#00FFFF" FontSize="16" FontWeight="Black" FontFamily="Arial Black"/>
                <ComboBox x:Name="CarSelectionComboBox" Width="280" Height="40" 
                          SelectionChanged="CarSelectionComboBox_SelectionChanged"
                          FontSize="14" FontWeight="Bold" Background="#0f3460" Foreground="#FFFFFF" 
                          BorderBrush="#FF00FF" BorderThickness="2"/>
                <Button x:Name="StartRaceButton" Content="🚀 IGNITION START!" Margin="25,0,0,0" 
                        Padding="25,10" Click="StartRaceButton_Click" FontWeight="Black" FontFamily="Arial Black"
                        Background="#FF1744" Foreground="#FFFFFF" BorderThickness="0" FontSize="15"/>
            </StackPanel>
        </Border>

        <!-- Game Status -->
        <Border Grid.Row="2" Background="#0f1419" BorderBrush="#FFFF00" BorderThickness="3" Padding="30" Margin="0,0,0,25">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Current Lap -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="🏁 CIRCUIT LAP:" Margin="0,10" 
                           VerticalAlignment="Center" Foreground="#00FFFF" FontWeight="Black" FontFamily="Arial Black" FontSize="15"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="CurrentLapLabel" Text="1/5" 
                           Margin="20,10" FontWeight="Black" Foreground="#00FF00" FontSize="20" FontFamily="Impact"/>

                <!-- Fuel Level -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="⛽ NITRO FUEL:" Margin="0,10" 
                           VerticalAlignment="Center" Foreground="#FF6600" FontWeight="Black" FontFamily="Arial Black" FontSize="15"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="20,10">
                    <Border BorderBrush="#FF6600" BorderThickness="2" Background="#000000">
                        <ProgressBar x:Name="FuelProgressBar" Width="280" Height="30" Maximum="100" Value="100"
                                     Background="#1a0000" Foreground="#FF3300" BorderThickness="0"/>
                    </Border>
                    <TextBlock x:Name="FuelPercentageLabel" Text="100%" Margin="20,0" 
                               VerticalAlignment="Center" Foreground="#FF3300" FontWeight="Black" FontFamily="Impact" FontSize="16"/>
                </StackPanel>

                <!-- Time Remaining -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="⏱️ RACE CLOCK:" Margin="0,10" 
                           VerticalAlignment="Center" Foreground="#FF0080" FontWeight="Black" FontFamily="Arial Black" FontSize="15"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="20,10">
                    <Border BorderBrush="#FF0080" BorderThickness="2" Background="#000000">
                        <ProgressBar x:Name="TimeProgressBar" Width="280" Height="30" Maximum="100" Value="100"
                                     Background="#1a0010" Foreground="#FF0040" BorderThickness="0"/>
                    </Border>
                    <TextBlock x:Name="TimeRemainingLabel" Text="5:00" Margin="20,0" 
                               VerticalAlignment="Center" Foreground="#FF0040" FontWeight="Black" FontFamily="Impact" FontSize="16"/>
                </StackPanel>

                <!-- Current Speed -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="🚀 VELOCITY:" Margin="0,10" 
                           VerticalAlignment="Center" Foreground="#00FFFF" FontWeight="Black" FontFamily="Arial Black" FontSize="15"/>
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="CurrentSpeedLabel" Text="0 km/h" 
                           Margin="20,10" FontWeight="Black" Foreground="#00DDFF" FontSize="20" FontFamily="Impact"/>

                <!-- Race Status -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="🏁 RACE STATUS:" Margin="0,10" 
                           VerticalAlignment="Center" Foreground="#FFFF00" FontWeight="Black" FontFamily="Arial Black" FontSize="15"/>
                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="RaceStatusLabel" Text="Select a car to start" 
                           Margin="20,10" Foreground="#FFDD00" FontWeight="Bold" FontFamily="Arial" FontSize="14"/>

                <!-- Progress Indicator -->
                <TextBlock Grid.Row="5" Grid.Column="0" Text="🏁 TRACK PROGRESS:" Margin="0,10" 
                           VerticalAlignment="Center" Foreground="#FF00FF" FontWeight="Black" FontFamily="Arial Black" FontSize="15"/>
                <TextBlock Grid.Row="5" Grid.Column="1" x:Name="ProgressIndicatorLabel" Text="[          ]" 
                           Margin="20,10" FontFamily="Courier New" FontWeight="Black" Foreground="#FF44FF" FontSize="16"/>

                <!-- Action Log -->
                <TextBlock Grid.Row="6" Grid.Column="0" Text="📱 RACE LOG:" Margin="0,10" 
                           VerticalAlignment="Top" Foreground="#00FF80" FontWeight="Black" FontFamily="Arial Black" FontSize="15"/>
                <Border Grid.Row="6" Grid.Column="1" Margin="20,10" Background="#001100" 
                        BorderBrush="#00FF80" BorderThickness="2">
                    <ScrollViewer Height="100" VerticalScrollBarVisibility="Auto" Padding="12">
                        <TextBlock x:Name="ActionLogTextBlock" Text="" FontFamily="Courier New" FontSize="12" 
                                   TextWrapping="Wrap" VerticalAlignment="Top" Foreground="#00FF40" FontWeight="Bold"/>
                    </ScrollViewer>
                </Border>
            
                <!-- Race Result -->
                <Border Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" x:Name="RaceResultBorder" 
                        Margin="0,15,0,0" Padding="15" Visibility="Collapsed"
                        Background="#4CAF50">
                    <TextBlock x:Name="RaceResultLabel" Text="" FontSize="18" FontWeight="Bold" 
                               Foreground="White" HorizontalAlignment="Center" TextAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,25">
            <Button x:Name="SpeedUpButton" Content="🚀 TURBO BOOST" Padding="25,15" Margin="15" 
                    Click="SpeedUpButton_Click" IsEnabled="False" FontWeight="Black" FontSize="14" FontFamily="Arial Black"
                    Background="#FF1100" Foreground="#FFFFFF" BorderThickness="3" BorderBrush="#FF4400"/>
            <Button x:Name="MaintainSpeedButton" Content="🎯 CRUISE CONTROL" Padding="25,15" Margin="15" 
                    Click="MaintainSpeedButton_Click" IsEnabled="False" FontWeight="Black" FontSize="14" FontFamily="Arial Black"
                    Background="#0066FF" Foreground="#FFFFFF" BorderThickness="3" BorderBrush="#0099FF"/>
            <Button x:Name="PitStopButton" Content="🔧 GARAGE STOP" Padding="25,15" Margin="15" 
                    Click="PitStopButton_Click" IsEnabled="False" FontWeight="Black" FontSize="14" FontFamily="Arial Black"
                    Background="#8800FF" Foreground="#FFFFFF" BorderThickness="3" BorderBrush="#AA44FF"/>
        </StackPanel>

        <!-- Car Info -->
        <Border Grid.Row="4" Background="#0d1b2a" BorderBrush="#00FFFF" BorderThickness="2" Padding="20" Margin="0,0,0,0">
            <TextBlock x:Name="CarInfoLabel" Text="" HorizontalAlignment="Center" 
                       FontWeight="Bold" Foreground="#00DDFF" TextAlignment="Center" TextWrapping="Wrap" 
                       FontFamily="Arial" FontSize="13"/>
        </Border>
    </Grid>
</Window>