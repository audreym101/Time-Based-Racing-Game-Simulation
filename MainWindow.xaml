<Window x:Class="TimeBasedRacingGame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🏁 NEON RACEWAY - Ultimate Speed Challenge" Height="700" Width="900"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="#2d2d30">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <Border Grid.Row="0" Padding="20" Margin="0,0,0,30">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF00FF" Offset="0"/>
                    <GradientStop Color="#00FFFF" Offset="0.5"/>
                    <GradientStop Color="#FFFF00" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel>
                <TextBlock Text="🏎️ NEON RACEWAY 🏎️" FontSize="28" FontWeight="Bold" 
                           HorizontalAlignment="Center" Foreground="White" 
                           FontFamily="Segoe UI" TextAlignment="Center"/>
                <TextBlock Text="ULTIMATE SPEED CHALLENGE" FontSize="12" FontWeight="Bold" 
                           HorizontalAlignment="Center" Foreground="White" 
                           FontFamily="Segoe UI" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Car Selection -->
        <Border Grid.Row="1" Background="#16213e" BorderBrush="#00FFFF" BorderThickness="2" Padding="25" Margin="0,0,0,30">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="🏎️ CHOOSE YOUR MACHINE:" VerticalAlignment="Center" Margin="0,0,20,0" 
                           Foreground="White" FontSize="14" FontWeight="Bold" FontFamily="Segoe UI"/>
                <ComboBox x:Name="CarSelectionComboBox" Width="250" Height="35" 
                          SelectionChanged="CarSelectionComboBox_SelectionChanged"
                          FontSize="12" Background="White" Foreground="Black" 
                          BorderBrush="Gray" BorderThickness="1"/>
                <Button x:Name="StartRaceButton" Content="🚀 START RACE" Margin="20,0,0,0" 
                        Padding="15,8" Click="StartRaceButton_Click" FontWeight="Bold" FontFamily="Segoe UI"
                        Background="#4CAF50" Foreground="White" BorderThickness="0" FontSize="12"/>
            </StackPanel>
        </Border>

        <!-- Game Status -->
        <Border Grid.Row="2" Background="#3c3c3c" BorderBrush="#555" BorderThickness="1" Padding="20" Margin="0,0,0,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Current Lap -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="🏁 Current Lap:" Margin="0,8" 
                           VerticalAlignment="Center" Foreground="White" FontWeight="Bold" FontFamily="Segoe UI" FontSize="14"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="CurrentLapLabel" Text="1/5" 
                           Margin="15,8" FontWeight="Bold" Foreground="#4CAF50" FontSize="16" FontFamily="Segoe UI"/>

                <!-- Fuel Level -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="⛽ Fuel Level:" Margin="0,8" 
                           VerticalAlignment="Center" Foreground="White" FontWeight="Bold" FontFamily="Segoe UI" FontSize="14"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="15,8">
                    <ProgressBar x:Name="FuelProgressBar" Width="250" Height="25" Maximum="100" Value="100"
                                 Background="#555" Foreground="#FF9800" BorderThickness="1" BorderBrush="#777"/>
                    <TextBlock x:Name="FuelPercentageLabel" Text="100%" Margin="15,0" 
                               VerticalAlignment="Center" Foreground="#FF9800" FontWeight="Bold" FontFamily="Segoe UI" FontSize="14"/>
                </StackPanel>

                <!-- Time Remaining -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="⏱️ Time Remaining:" Margin="0,8" 
                           VerticalAlignment="Center" Foreground="White" FontWeight="Bold" FontFamily="Segoe UI" FontSize="14"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="15,8">
                    <ProgressBar x:Name="TimeProgressBar" Width="250" Height="25" Maximum="100" Value="100"
                                 Background="#555" Foreground="#f44336" BorderThickness="1" BorderBrush="#777"/>
                    <TextBlock x:Name="TimeRemainingLabel" Text="5:00" Margin="15,0" 
                               VerticalAlignment="Center" Foreground="#f44336" FontWeight="Bold" FontFamily="Segoe UI" FontSize="14"/>
                </StackPanel>

                <!-- Current Speed -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="🚀 Current Speed:" Margin="0,8" 
                           VerticalAlignment="Center" Foreground="White" FontWeight="Bold" FontFamily="Segoe UI" FontSize="14"/>
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="CurrentSpeedLabel" Text="0 km/h" 
                           Margin="15,8" FontWeight="Bold" Foreground="#2196F3" FontSize="16" FontFamily="Segoe UI"/>

                <!-- Race Status -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="🏁 Status:" Margin="0,8" 
                           VerticalAlignment="Center" Foreground="White" FontWeight="Bold" FontFamily="Segoe UI" FontSize="14"/>
                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="RaceStatusLabel" Text="Select a car to start" 
                           Margin="15,8" Foreground="#FFC107" FontWeight="Bold" FontFamily="Segoe UI" FontSize="14"/>

                <!-- Progress Indicator -->
                <TextBlock Grid.Row="5" Grid.Column="0" Text="🏁 Lap Progress:" Margin="0,8" 
                           VerticalAlignment="Center" Foreground="White" FontWeight="Bold" FontFamily="Segoe UI" FontSize="14"/>
                <TextBlock Grid.Row="5" Grid.Column="1" x:Name="ProgressIndicatorLabel" Text="[          ]" 
                           Margin="15,8" FontFamily="Consolas" FontWeight="Bold" Foreground="#9C27B0" FontSize="14"/>

                <!-- Action Log -->
                <TextBlock Grid.Row="6" Grid.Column="0" Text="📜 Action Log:" Margin="0,8" 
                           VerticalAlignment="Top" Foreground="White" FontWeight="Bold" FontFamily="Segoe UI" FontSize="14"/>
                <Border Grid.Row="6" Grid.Column="1" Margin="15,8" Background="#2a2a2a" 
                        BorderBrush="#555" BorderThickness="1">
                    <ScrollViewer Height="90" VerticalScrollBarVisibility="Auto" Padding="10">
                        <TextBlock x:Name="ActionLogTextBlock" Text="" FontFamily="Consolas" FontSize="11" 
                                   TextWrapping="Wrap" VerticalAlignment="Top" Foreground="#00FF00" FontWeight="Normal"/>
                    </ScrollViewer>
                </Border>
            
                <!-- Race Result -->
                <Border Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" x:Name="RaceResultBorder" 
                        Margin="0,15,0,0" Padding="15" Visibility="Collapsed"
                        Background="#4CAF50">
                    <TextBlock x:Name="RaceResultLabel" Text="" FontSize="18" FontWeight="Bold" 
                               Foreground="White" HorizontalAlignment="Center" TextAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
            <Button x:Name="SpeedUpButton" Content="⚡ SPEED UP" Padding="20,12" Margin="10" 
                    Click="SpeedUpButton_Click" IsEnabled="False" FontWeight="Bold" FontSize="13" FontFamily="Segoe UI"
                    Background="#FF5722" Foreground="White" BorderThickness="0"/>
            <Button x:Name="MaintainSpeedButton" Content="🔄 MAINTAIN" Padding="20,12" Margin="10" 
                    Click="MaintainSpeedButton_Click" IsEnabled="False" FontWeight="Bold" FontSize="13" FontFamily="Segoe UI"
                    Background="#2196F3" Foreground="White" BorderThickness="0"/>
            <Button x:Name="PitStopButton" Content="🔧 PIT STOP" Padding="20,12" Margin="10" 
                    Click="PitStopButton_Click" IsEnabled="False" FontWeight="Bold" FontSize="13" FontFamily="Segoe UI"
                    Background="#9C27B0" Foreground="White" BorderThickness="0"/>
        </StackPanel>

        <!-- Car Info -->
        <Border Grid.Row="4" Background="#3c3c3c" BorderBrush="#555" BorderThickness="1" Padding="15" Margin="0,0,0,0">
            <TextBlock x:Name="CarInfoLabel" Text="" HorizontalAlignment="Center" 
                       FontWeight="Normal" Foreground="#E0E0E0" TextAlignment="Center" TextWrapping="Wrap" 
                       FontFamily="Segoe UI" FontSize="12" FontStyle="Italic"/>
        </Border>
    </Grid>
</Window>