<Window x:Class="TimeBasedRacingGame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="C# Speed Rush - Time-Based Racing Game" Height="500" Width="600"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="C# Speed Rush" FontSize="24" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <!-- Car Selection -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
            <TextBlock Text="Select Car:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="CarSelectionComboBox" Width="200" SelectionChanged="CarSelectionComboBox_SelectionChanged"/>
            <Button x:Name="StartRaceButton" Content="Start Race" Margin="10,0,0,0" Padding="10,5" Click="StartRaceButton_Click"/>
        </StackPanel>

        <!-- Game Status -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Current Lap -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Current Lap:" Margin="0,5" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="CurrentLapLabel" Text="1/5" Margin="10,5" FontWeight="Bold"/>

            <!-- Fuel Level -->
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Fuel Level:" Margin="0,5" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="10,5">
                <ProgressBar x:Name="FuelProgressBar" Width="200" Height="20" Maximum="100" Value="100"/>
                <TextBlock x:Name="FuelPercentageLabel" Text="100%" Margin="10,0" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Time Remaining -->
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Time Remaining:" Margin="0,5" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="10,5">
                <ProgressBar x:Name="TimeProgressBar" Width="200" Height="20" Maximum="100" Value="100"/>
                <TextBlock x:Name="TimeRemainingLabel" Text="5:00" Margin="10,0" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Current Speed -->
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Current Speed:" Margin="0,5" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="CurrentSpeedLabel" Text="0 km/h" Margin="10,5" FontWeight="Bold"/>

            <!-- Race Status -->
            <TextBlock Grid.Row="4" Grid.Column="0" Text="Status:" Margin="0,5" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="RaceStatusLabel" Text="Select a car to start" Margin="10,5"/>

            <!-- Progress Indicator -->
            <TextBlock Grid.Row="5" Grid.Column="0" Text="Lap Progress:" Margin="0,5" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="5" Grid.Column="1" x:Name="ProgressIndicatorLabel" Text="[          ]" 
                       Margin="10,5" FontFamily="Consolas" FontWeight="Bold"/>

            <!-- Race Result -->
            <TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" x:Name="RaceResultLabel" 
                       Text="" FontSize="16" FontWeight="Bold" Foreground="Red" 
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button x:Name="SpeedUpButton" Content="Speed Up" Padding="15,8" Margin="5" Click="SpeedUpButton_Click" IsEnabled="False"/>
            <Button x:Name="MaintainSpeedButton" Content="Maintain Speed" Padding="15,8" Margin="5" Click="MaintainSpeedButton_Click" IsEnabled="False"/>
            <Button x:Name="PitStopButton" Content="Pit Stop" Padding="15,8" Margin="5" Click="PitStopButton_Click" IsEnabled="False"/>
        </StackPanel>

        <!-- Car Info -->
        <TextBlock Grid.Row="4" x:Name="CarInfoLabel" Text="" HorizontalAlignment="Center" 
                   Margin="0,10,0,0" FontStyle="Italic"/>
    </Grid>
</Window>