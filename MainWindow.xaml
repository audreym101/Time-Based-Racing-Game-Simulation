<Window x:Class="TimeBasedRacingGame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="C# Speed Rush - Time-Based Racing Game" Height="650" Width="800"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="#1e1e1e">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <Border Grid.Row="0" Background="#ff6b35" Padding="15" Margin="0,0,0,25">
            <TextBlock Text="🏎️ C# SPEED RUSH" FontSize="28" FontWeight="Bold" 
                       HorizontalAlignment="Center" Foreground="White" 
                       FontFamily="Segoe UI Black"/>
        </Border>

        <!-- Car Selection -->
        <Border Grid.Row="1" Background="#2d2d30" Padding="20" Margin="0,0,0,25">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="🚗 Select Car:" VerticalAlignment="Center" Margin="0,0,15,0" 
                           Foreground="#ffffff" FontSize="14" FontWeight="SemiBold"/>
                <ComboBox x:Name="CarSelectionComboBox" Width="250" Height="35" 
                          SelectionChanged="CarSelectionComboBox_SelectionChanged"
                          FontSize="13" Background="#3c3c3c" Foreground="White" BorderBrush="#555"/>
                <Button x:Name="StartRaceButton" Content="🏁 START RACE" Margin="20,0,0,0" 
                        Padding="20,8" Click="StartRaceButton_Click" FontWeight="Bold"
                        Background="#4CAF50" Foreground="White" BorderThickness="0" FontSize="14"/>
            </StackPanel>
        </Border>

        <!-- Game Status -->
        <Border Grid.Row="2" Background="#2d2d30" Padding="25" Margin="0,0,0,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Current Lap -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="🏁 Current Lap:" Margin="0,8" 
                           VerticalAlignment="Center" Foreground="#ffffff" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="CurrentLapLabel" Text="1/5" 
                           Margin="15,8" FontWeight="Bold" Foreground="#4CAF50" FontSize="16"/>

                <!-- Fuel Level -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="⛽ Fuel Level:" Margin="0,8" 
                           VerticalAlignment="Center" Foreground="#ffffff" FontWeight="SemiBold"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="15,8">
                    <ProgressBar x:Name="FuelProgressBar" Width="250" Height="25" Maximum="100" Value="100"
                                 Background="#444" Foreground="#FF9800" BorderThickness="1" BorderBrush="#666"/>
                    <TextBlock x:Name="FuelPercentageLabel" Text="100%" Margin="15,0" 
                               VerticalAlignment="Center" Foreground="#FF9800" FontWeight="Bold"/>
                </StackPanel>

                <!-- Time Remaining -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="⏱️ Time Remaining:" Margin="0,8" 
                           VerticalAlignment="Center" Foreground="#ffffff" FontWeight="SemiBold"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="15,8">
                    <ProgressBar x:Name="TimeProgressBar" Width="250" Height="25" Maximum="100" Value="100"
                                 Background="#444" Foreground="#f44336" BorderThickness="1" BorderBrush="#666"/>
                    <TextBlock x:Name="TimeRemainingLabel" Text="5:00" Margin="15,0" 
                               VerticalAlignment="Center" Foreground="#f44336" FontWeight="Bold"/>
                </StackPanel>

                <!-- Current Speed -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="📊 Current Speed:" Margin="0,8" 
                           VerticalAlignment="Center" Foreground="#ffffff" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="CurrentSpeedLabel" Text="0 km/h" 
                           Margin="15,8" FontWeight="Bold" Foreground="#2196F3" FontSize="16"/>

                <!-- Race Status -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="📊 Status:" Margin="0,8" 
                           VerticalAlignment="Center" Foreground="#ffffff" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="RaceStatusLabel" Text="Select a car to start" 
                           Margin="15,8" Foreground="#FFC107" FontStyle="Italic"/>

                <!-- Progress Indicator -->
                <TextBlock Grid.Row="5" Grid.Column="0" Text="🏁 Lap Progress:" Margin="0,8" 
                           VerticalAlignment="Center" Foreground="#ffffff" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="5" Grid.Column="1" x:Name="ProgressIndicatorLabel" Text="[          ]" 
                           Margin="15,8" FontFamily="Consolas" FontWeight="Bold" Foreground="#9C27B0" FontSize="14"/>

                <!-- Action Log -->
                <TextBlock Grid.Row="6" Grid.Column="0" Text="📜 Action Log:" Margin="0,8" 
                           VerticalAlignment="Top" Foreground="#ffffff" FontWeight="SemiBold"/>
                <Border Grid.Row="6" Grid.Column="1" Margin="15,8" Background="#1a1a1a" 
                        BorderBrush="#555" BorderThickness="1">
                    <ScrollViewer Height="90" VerticalScrollBarVisibility="Auto" Padding="10">
                        <TextBlock x:Name="ActionLogTextBlock" Text="" FontFamily="Consolas" FontSize="11" 
                                   TextWrapping="Wrap" VerticalAlignment="Top" Foreground="#00FF00"/>
                    </ScrollViewer>
                </Border>
            
                <!-- Race Result -->
                <Border Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" x:Name="RaceResultBorder" 
                        Margin="0,15,0,0" Padding="15" Visibility="Collapsed"
                        Background="#4CAF50">
                    <TextBlock x:Name="RaceResultLabel" Text="" FontSize="18" FontWeight="Bold" 
                               Foreground="White" HorizontalAlignment="Center" TextAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
            <Button x:Name="SpeedUpButton" Content="⚡ SPEED UP" Padding="20,12" Margin="10" 
                    Click="SpeedUpButton_Click" IsEnabled="False" FontWeight="Bold" FontSize="13"
                    Background="#FF5722" Foreground="White" BorderThickness="0"/>
            <Button x:Name="MaintainSpeedButton" Content="🔄 MAINTAIN" Padding="20,12" Margin="10" 
                    Click="MaintainSpeedButton_Click" IsEnabled="False" FontWeight="Bold" FontSize="13"
                    Background="#2196F3" Foreground="White" BorderThickness="0"/>
            <Button x:Name="PitStopButton" Content="🔧 PIT STOP" Padding="20,12" Margin="10" 
                    Click="PitStopButton_Click" IsEnabled="False" FontWeight="Bold" FontSize="13"
                    Background="#9C27B0" Foreground="White" BorderThickness="0"/>
        </StackPanel>

        <!-- Car Info -->
        <Border Grid.Row="4" Background="#3c3c3c" Padding="15" Margin="0,0,0,0">
            <TextBlock x:Name="CarInfoLabel" Text="" HorizontalAlignment="Center" 
                       FontStyle="Italic" Foreground="#E0E0E0" TextAlignment="Center" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>